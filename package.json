{
  "name": "bhalaji-research-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Build-time accessibility, performance, and research-publication audits for bhalaji.com",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "audit:a11y": "pa11y-ci --config .pa11yci.cjs",
    "audit:lighthouse": "lhci autorun --config=.lighthouserc.cjs",
    "audit:notes": "python3 scripts/check_notes_governance.py"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "pa11y-ci": "4.1.1"
  }
}
